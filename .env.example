# สร้าง API key จาก Google Cloud Console แล้วใส่ค่าในไฟล์ .env.local
# เปิดใช้ YouTube Data API v3 ให้กับ key นี้
YOUTUBE_API_KEY=

# TikTok ต้องใช้ OAuth access token ของบัญชีเจ้าของช่องเพื่อดึงสถิติ/รายการวิดีโอแบบ realtime
# TIKTOK_ACCESS_TOKEN=

# Google Sheets ID สำหรับเชื่อมต่อสินค้า & หมวดหมู่แบบ Real-time (แชร์ Sheet เป็น Anyone with the link can view)
GOOGLE_SHEET_ID=